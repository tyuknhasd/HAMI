# Rendered to /etc/nginx/conf.d/default.conf at container start with $PORT
# substituted in (see entrypoint.sh). Plain HTTP is correct here: on Railway,
# TLS is already terminated at Railway's edge before traffic reaches us.
server {
    listen ${PORT};

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /hami-ws {
        proxy_pass http://127.0.0.1:8443;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    location /hami-trojan-ws {
        proxy_pass http://127.0.0.1:8446;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    location /hami-xhttp {
        proxy_pass http://127.0.0.1:8445;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}